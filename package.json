{
  "name": "gridcraft-embed",
  "version": "0.1.9",
  "description": "Excel-like spreadsheet for React and JavaScript in the browser, with formulas, XLSX import/export, dark mode and an embeddable Gridcraft UI.",
  "keywords": [
    "excel",
    "excel-like",
    "spreadsheet",
    "react-spreadsheet",
    "javascript-spreadsheet",
    "browser-spreadsheet",
    "web-spreadsheet",
    "spreadsheet-component",
    "xlsx",
    "formulas",
    "react",
    "javascript",
    "typescript",
    "webassembly",
    "gridcraft"
  ],
  "type": "module",
  "license": "MIT OR Apache-2.0",
  "files": [
    "dist",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "NOTICE",
    "CHANGELOG.md",
    "ATTRIBUTION.md",
    "UPSTREAM.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./wasm/*": "./dist/wasm/*"
  },
  "sideEffects": false,
  "peerDependencies": {
    "react": ">=18 <20"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "scripts": {
    "upstream:prepare": "node scripts/prepare-upstream.mjs",
    "build": "node scripts/build-wasm.mjs",
    "prepack": "node scripts/check-package.mjs",
    "dev": "vite demo --host 127.0.0.1",
    "demo:build": "vite build demo",
    "test": "node --test test/*.test.mjs",
    "test:isolation": "node test/isolation.mjs",
    "test:browser": "node test/browser.mjs"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright": "^1.56.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=22.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PonyTrap420/gridcraft-embed.git"
  },
  "homepage": "https://github.com/PonyTrap420/gridcraft-embed#readme",
  "bugs": {
    "url": "https://github.com/PonyTrap420/gridcraft-embed/issues"
  },
  "gridcraftUpstream": {
    "repository": "storytold/gridcraft",
    "releaseId": 418516765,
    "tag": "v0.9.0",
    "commit": "a2cc4b42cac6e2c41bae71fba4607300755a0b47"
  }
}
