+    /// Automatic text follows the UI theme, with contrast against an explicit cell fill.
+    /// This affects painting only; workbook colours and exported styles are unchanged.
+    pub fn automatic_cell_text(&self, fill: Option<Color32>) -> Color32 {
+        let Some(fill) = fill.filter(|_| self.dark) else { return self.cell_text };
+        let linear = |channel: u8| {
+            let value = f32::from(channel) / 255.0;
+            if value <= 0.04045 { value / 12.92 } else { ((value + 0.055) / 1.055).powf(2.4) }
+        };
+        let luminance = 0.2126 * linear(fill.r()) + 0.7152 * linear(fill.g()) + 0.0722 * linear(fill.b());
+        if luminance > 0.179 { Color32::BLACK } else { Color32::WHITE }
+    }
